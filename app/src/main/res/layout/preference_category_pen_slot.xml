<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/PreferenceCategoryWithShadow" />

    <!-- A labeled button rather than a bare "-": an icon-only affordance sitting
         in a list of text rows reads as decoration, and there was no way to tell
         whether it removes the slot or collapses it. -->
    <TextView
        android:id="@+id/pen_slot_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="52dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/title_pen_wheel_remove_slot"
        android:text="@string/title_pen_wheel_remove_slot"
        android:textColor="?attr/appAccent"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
